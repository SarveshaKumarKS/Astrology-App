# Base URL of the FastAPI backend the app talks to.
#
# IMPORTANT: on a physical Android device "localhost" points at the phone,
# not your computer. Use one of:
#   - your machine's LAN IP:   http://192.168.1.50:8001
#   - an ngrok tunnel:         https://<something>.ngrok-free.app
#   - a deployed backend URL:  https://api.yourhost.com
#
# Copy this file to `.env` (or `.env.local`) and set the value before building.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
